<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX package description for Pinglish (Microsoft Store).
  build_msix.ps1 fills the @@...@@ values from identity.json and the version.
  Pinglish is a desktop app, so it runs with full trust like the .exe install.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="@@NAME@@"
    Publisher="@@PUBLISHER@@"
    Version="@@VERSION@@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>@@DISPLAY_NAME@@</DisplayName>
    <PublisherDisplayName>@@PUBLISHER_DISPLAY_NAME@@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Pinglish" Executable="Pinglish.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="@@DISPLAY_NAME@@"
        Description="Type Persian in Latin letters, or just speak it, and get proper Persian script."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" ShortName="Pinglish" />
      </uap:VisualElements>
      <Extensions>
        <!-- Off by default; the user can switch it on in Settings > Apps > Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="Pinglish.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="PinglishStartup" Enabled="false" DisplayName="Pinglish" />
        </desktop:Extension>
        <!-- Lets "pinglish" start the app from the Run box (Win+R) or a terminal. -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Pinglish.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="pinglish.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Speech recognition sends audio to Google, only while the mic button is on. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <!-- Windows asks the user before the first recording. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
